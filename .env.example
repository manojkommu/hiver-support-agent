# Copy this file to `.env` and fill in your key. NEVER commit the real .env.
# Get a free key at https://aistudio.google.com  ("Get API key").
GEMINI_API_KEY=your_key_here

# Free-tier Flash model. Change only if you know the model id exists on your tier.
GEMINI_MODEL=gemini-2.5-flash

# Seconds between LLM calls. 6s ~= 10 requests/min (free-tier safe). Lower if you enable billing.
LLM_MIN_INTERVAL=6.5
